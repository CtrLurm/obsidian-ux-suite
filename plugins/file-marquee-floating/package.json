{
  "name": "obsidian-file-marquee",
  "version": "1.0.0",
  "description": "在文件列表中长按框选多个文件或文件夹，批量移动或删除，并可把文件列表和功能区拉出为浮动小窗。",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "node scripts/run-tests.mjs",
    "smoke": "node scripts/smoke-load.mjs",
    "package": "node scripts/package.mjs",
    "release": "npm run build && npm run test && npm run smoke && npm run package"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "file-explorer",
    "marquee",
    "drag-select",
    "floating-panel"
  ],
  "author": "CtrLurm",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.0",
    "obsidian": "^1.14.0",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0"
  }
}
