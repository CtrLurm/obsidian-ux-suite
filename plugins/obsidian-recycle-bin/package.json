{
  "name": "obsidian-recycle-bin",
  "version": "1.0.0",
  "description": "Obsidian 内嵌回收站：删除的文件集中管理，可批量恢复或彻底删除",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "node scripts/run-tests.mjs",
    "smoke": "node scripts/smoke-load.mjs",
    "package": "node scripts/package.mjs",
    "release": "npm run build && npm run test && npm run smoke && npm run package"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "recycle-bin",
    "trash"
  ],
  "author": "CtrLurm",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.0",
    "obsidian": "^1.14.0",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0"
  }
}
